[Unit]
Description=Cursor G2 ACP bridge
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=cursor-g2
WorkingDirectory=/opt/cursor-cli-even-g2
EnvironmentFile=/etc/cursor-g2.env
ExecStart=/usr/bin/node /opt/cursor-cli-even-g2/server/dist/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/cursor-g2/.local/state /srv/projects

[Install]
WantedBy=multi-user.target
