# Long random token shared only with the Even Hub app.
BRIDGE_TOKEN=replace-with-a-random-token

# Exact web origins allowed by CORS. Add the Even App WebView origin if needed.
ALLOWED_ORIGINS=*

# Comma-separated directories containing projects the bridge may open.
ALLOWED_PROJECT_ROOTS=/home/user/projects

# Cursor CLI authentication. Prefer running `agent login` as the service user.
# CURSOR_API_KEY=
# CURSOR_AUTH_TOKEN=
# CURSOR_AGENT_PATH=/home/user/.local/bin/agent

# OpenAI-compatible audio transcription API.
STT_API_KEY=replace-with-your-stt-key
STT_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1

HOST=127.0.0.1
PORT=3456
