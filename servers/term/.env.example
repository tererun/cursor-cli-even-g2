# Long random token shared only with the Even Hub term app.
BRIDGE_TOKEN=replace-with-a-random-token

# Exact web origins allowed by CORS. Add the Even App WebView origin if needed.
ALLOWED_ORIGINS=*

# Local shell / nvim working directories the bridge may open.
ALLOWED_PROJECT_ROOTS=/home/user/projects

# Optional. If set, SSH targets must match one of these hosts or Host aliases.
# ALLOWED_SSH_HOSTS=devbox,100.64.0.12,example.com

# Optional. Local executables the bridge may spawn. Defaults include shells, nvim, ssh.
# ALLOWED_COMMANDS=bash,zsh,sh,fish,nvim,vim,vi,ssh

HOST=127.0.0.1
PORT=3457

# G2 HUD budget. 38x12 stays near the glasses text-container limit and still fits nvim.
# DEFAULT_COLS=38
# DEFAULT_ROWS=12
# DEFAULT_SHELL=/bin/bash
